<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ r.meta.naam }} – rapport {{ r.meta.datum }}</title>
<style>{{ css }}</style>
</head>
<body>
{%- macro lab(l) -%}<span class="lab {{ l }}">{{ labels[l] }}</span>{%- endmacro -%}

{%- macro blok(b) -%}
  {%- if b.type == 'tekst' -%}
    <p class="blok {{ b.label }}">{{ lab(b.label) }}{{ b.tekst|inline }}{{ b.bronnen|refs }}</p>
  {%- elif b.type == 'lijst' -%}
    {%- if b.titel %}<div class="tabel-titel">{{ b.titel }}</div>{% endif -%}
    <ul class="blokken">
    {%- for it in b['items'] %}
      <li class="blok {{ it.label }}">{{ lab(it.label) }}{{ it.tekst|inline }}{{ it.bronnen|refs }}</li>
    {%- endfor %}
    </ul>
  {%- elif b.type == 'uitleg' -%}
    <p class="leestekst">{{ b.tekst|inline }}</p>
  {%- elif b.type == 'kop' -%}
    <h3 class="tussentitel pdf-blok pdf-klein">{{ b.tekst }}</h3>
  {%- elif b.type == 'kader' -%}
    <div class="kader {{ b.stijl or 'info' }}">{% if b.titel %}<div class="t">{{ b.titel }}</div>{% endif %}{{ b.tekst|inline }}</div>
  {%- elif b.type == 'kerncijfers' -%}
    <div class="kerncijfers">
    {%- for it in b['items'] %}
      {%- set kop_tegel %}
        <div class="n">{{ it.naam }}</div>
        <div class="w">{{ it.waarde }}{% if it.trend %} <span class="trend {{ it.trend }}">{{ {'op':'▲','neer':'▼','gelijk':'▬'}[it.trend] }}</span>{% endif %}{{ it.bronnen|refs }}</div>
        {%- if it.toelichting %}<div class="t">{{ lab(it.label) }}{{ it.toelichting|inline }}</div>{% endif %}
        {%- if it.beoordeling %}<div class="beoordeling {{ it.beoordeling }}"><i></i>{{ it.beoordeling }}</div>{% endif %}
      {%- endset %}
      {%- if it.wat or it.hoe or it.beoordeling_uitleg %}
      <details class="tegel meer">
        <summary>{{ kop_tegel }}<span class="meer-knop">Uitleg</span></summary>
        <div class="meer-inhoud">
          {%- if it.wat %}<p><strong>Wat is dit?</strong> {{ it.wat|inline }}</p>{% endif %}
          {%- if it.hoe %}<p><strong>Hoe berekend?</strong> {{ it.hoe|inline }}</p>{% endif %}
          {%- if it.beoordeling_uitleg %}<p><strong>Goed of slecht?</strong> {{ lab('mening') }}{{ it.beoordeling_uitleg|inline }}</p>{% endif %}
        </div>
      </details>
      {%- else %}
      <div class="tegel">{{ kop_tegel }}</div>
      {%- endif %}
    {%- endfor %}
    </div>
  {%- elif b.type == 'tabel' -%}
    {%- if b.titel %}<div class="tabel-titel">{{ b.titel }}{{ b.bronnen|refs }}</div>{% endif -%}
    <div class="tabelwrap"><table>
      <thead><tr>{% for k in b.kolommen %}<th>{{ k }}</th>{% endfor %}</tr></thead>
      <tbody>{% for rij in b.rijen %}<tr>{% for c in rij %}<td>{{ c|inline if c is string else c|getal }}</td>{% endfor %}</tr>{% endfor %}</tbody>
    </table></div>
    {%- if b.noot %}<div class="bijschrift">{{ b.noot|inline }}</div>{% endif -%}
  {%- elif b.type == 'grafiek' -%}
    <div class="grafiek-blok">
    <div class="grafiek-titel">{{ b.titel }}{{ b.bronnen|refs }}</div>
    {{ b|svg }}
    <div class="bijschrift">{% if b.noot %}{{ b.noot|inline }} · {% endif %}{% if b.bron_tekst %}Bron: {{ b.bron_tekst }}{% endif %}</div>
    </div>
  {%- endif -%}
{%- endmacro -%}

{%- set a = r.advies -%}
<header class="kop"><div class="pagina">
  <div class="ticker">{{ r.meta.ticker }}{% if r.meta.beurs %} · {{ r.meta.beurs }}{% endif %}{% if r.meta.isin %} · {{ r.meta.isin }}{% endif %} · {{ r.meta.type|upper }}</div>
  {%- if r._concept %}<div style="display:inline-block;background:#fec84b;color:#101828;font-weight:700;font-size:12px;padding:2px 8px;border-radius:4px;margin:6px 0 2px">CONCEPT — nog niet volledig gereviewd</div>{% endif %}
  <h1>{{ r.meta.naam }}</h1>
  <div class="sub">{{ 'Snelle update' if r.meta.soort == 'snelle_update' else 'Rapport' }} van {{ r.meta.datum }}{% if r.meta.sector %} · {{ r.meta.sector }}{% endif %}{% if r.meta.defensief %} · Defensief{% endif %}{% if r.meta.vorig_rapport %} · vorig rapport: {{ r.meta.vorig_rapport }}{% endif %}</div>
</div></header>

<main class="pagina">
  {%- set d = namespace(sam=1, wijz=0, adv=2, vlag=3, det=4, ach=5) %}
  {%- if r.wijzigingen %}{% set d.wijz = 2 %}{% set d.adv = 3 %}{% set d.vlag = 4 %}{% set d.det = 5 %}{% set d.ach = 6 %}{% endif %}
  {%- set vl = r.meta.valuta or '' -%}

  <section class="pdf-blok kort-oordeel" id="oordeel">
    <div class="ko-kop">
      <div class="oordeel {{ a.oordeel.split(' ')[0] }}">{{ a.oordeel }}</div>
      {%- if a.score %}<div class="ko-score" aria-label="score {{ a.score }} op 10"><b>{{ a.score }}</b><small>/10</small></div>{% endif %}
    </div>
    {%- if a.score %}<div class="score" aria-hidden="true">{% for i in range(1, 11) %}<i class="{{ 'aan' if i <= a.score }}"></i>{% endfor %}</div>{% endif %}
    <div class="reden">{{ a.reden|inline }}</div>
    {%- if r._vlaggen %}<div class="ko-vlaggen">{% for v in r._vlaggen %}<a class="ko-vlag {{ v.ernst }}" href="#vlaggen">🚩 {{ {'nogo':'No-go','hoog':'Hoog','middel':'Middel'}[v.ernst] }}{% if v.regel %} · {{ v.regel }}{% endif %}</a>{% endfor %}</div>{% endif %}
  </section>

  <details class="pdf-blok kaart leeswijzer uitklap">
    <summary><h2>Hoe lees je dit rapport?</h2></summary>
    <p class="deel-intro">Het rapport gaat van kort naar uitgebreid. Bovenaan staat de conclusie; wil je weten waarom, lees dan verder of klap de details open.</p>
    <ul class="opbouw">
      <li><strong>Onderlijnd woord</strong> — tik erop en je krijgt de uitleg van die vakterm.</li>
      <li><strong>Vakje met "Uitleg"</strong> — tik op een cijfer om te lezen wat het is, hoe het berekend is en of het goed of slecht is.</li>
      <li><strong>Titel met een +</strong> — tik om dat stuk open te klappen.</li>
    </ul>
    <ol class="opbouw">
      <li><strong>Samenvatting</strong> — wat is dit bedrijf en wat vinden we ervan, op één scherm.</li>
      {%- if r.wijzigingen %}<li><strong>Wat is er veranderd</strong> — het verschil met het vorige rapport.</li>{% endif %}
      <li><strong>Het advies in cijfers</strong> — tegen welke prijs kopen, het koersdoel, wanneer verkopen, drie mogelijke uitkomsten voor de koers en hoe de score tot stand komt.</li>
      <li><strong>Rode vlaggen</strong> — wat botst met jouw harde regels.</li>
      <li><strong>Details per thema</strong> — {{ r.secties|length }} hoofdstukken om open te klappen, met alle cijfers, uitleg en bronnen.</li>
      <li><strong>Achteraan</strong> — woordenlijst, kwaliteitscontrole en bronnenlijst.</li>
    </ol>
    <p class="deel-intro" style="margin-top:10px">Elk stuk tekst krijgt een label, zodat je weet hoe zeker het is:</p>
    <div class="legende-labels">
      <span>{{ lab('feit') }}uit een bron, met verwijzing</span>
      <span>{{ lab('berekening') }}zelf berekend uit feiten</span>
      <span>{{ lab('inschatting') }}verwachting, kan anders uitdraaien</span>
      <span>{{ lab('mening') }}oordeel van de analist</span>
    </div>
  </details>

  <section class="pdf-blok kaart" id="samenvatting">
    <div class="deel">Deel {{ d.sam }}</div>
    <h2>Samenvatting</h2>
    <p class="deel-intro">Wat is dit bedrijf, en wat vinden we ervan? De kern in een paar punten.</p>
    {%- for b in r.samenvatting %}{{ blok(b) }}{% endfor %}
  </section>

  {%- if r.wijzigingen %}
  <section class="pdf-blok kaart">
    <div class="deel">Deel {{ d.wijz }}</div>
    <h2>Wat is er veranderd sinds het vorige rapport?</h2>
    {{ blok(r.wijzigingen[0]) }}
    {%- if r.wijzigingen|length > 1 %}
    <details class="uitklap onderdeel"><summary>Alle wijzigingen in detail</summary>{% for b in r.wijzigingen[1:] %}{{ blok(b) }}{% endfor %}</details>
    {%- endif %}
  </section>
  {%- endif %}

  <section class="advies" id="advies">
    <div class="vol">
      <div class="deel">Deel {{ d.adv }}</div>
      <h2>Het advies in cijfers</h2>
      <p class="deel-intro">De prijzen om in de gaten te houden, wat de koers de komende twee jaar zou kunnen doen, wanneer je verkoopt en hoe de score is opgebouwd.</p>
    </div>
    <div class="vol">
      <div class="sub-titel">Belangrijke prijzen</div>
      <p class="deel-intro">Alle prijzen op één lijn, van laag naar hoog. Tik op een prijs voor de uitleg.</p>
    </div>
    {%- set pb = r._prijsbalk %}
    {%- if pb %}
    <div class="vol prijsbalk" role="img" aria-label="Prijzen op een schaal van {{ pb.min|getal }} tot {{ pb.max|getal(vl) }}">
      <div class="pb-boven"><span class="pb-nu-label" style="left: {{ pb.nu }}%">koers nu</span></div>
      <div class="pb-spoor">
        {%- if pb.zone %}<i class="pb-zone" style="left: {{ pb.zone.links }}%; width: {{ pb.zone.breedte }}%"></i>{% endif %}
        {%- for x in pb.punten if not x.soort.startswith('sc') %}<i class="pb-streep {{ x.soort }}" style="left: {{ x.pos }}%"></i>{% endfor %}
        <i class="pb-nu" style="left: {{ pb.nu }}%"></i>
      </div>
      <div class="pb-onder">{% for x in pb.punten if x.soort.startswith('sc') %}<i class="pb-bol {{ x.naam }}" style="left: {{ x.pos }}%"></i>{% endfor %}</div>
      <div class="pb-as"><span>{{ pb.min|getal(vl) }}</span><span>{{ pb.max|getal(vl) }}</span></div>
      <div class="pb-legende"><span><i class="k zone"></i>koopzone</span><span><i class="k stop"></i>stop-loss</span><span><i class="k doel"></i>koersdoel</span><span><i class="k iw"></i>intrinsieke waarde</span><span><i class="k bol"></i>scenario's</span></div>
    </div>
    {%- endif %}
    <div class="vol prijzen">
      {%- if a.koers_nu is not none %}
      <div class="prijs"><div class="p-rij"><i class="k nu"></i><span class="p-naam">Koers nu{% if a.koers_datum %} <small>{{ a.koers_datum }}</small>{% endif %}</span><span class="p-w">{{ a.koers_nu|getal(vl) }}</span></div></div>
      {%- endif %}
      {%- if a.koopzone %}
      <details class="prijs"><summary class="p-rij"><i class="k zone"></i><span class="p-naam">Koopzone{% if r._pct.koopzone %} <small>{{ r._pct.koopzone }} t.o.v. nu</small>{% endif %}</span><span class="p-w">{{ a.koopzone.van|getal }} – {{ a.koopzone.tot|getal(vl) }}</span></summary>
        <p>De prijs waarbij kopen aantrekkelijk wordt: het mogelijke rendement weegt dan op tegen het risico. Staat de koers erboven, dan betaal je meer dan wij verantwoord vinden.</p></details>
      {%- endif %}
      {%- if a.koersdoel is not none %}
      <details class="prijs"><summary class="p-rij"><i class="k doel"></i><span class="p-naam">Koersdoel (2 jaar){% if r._pct.koersdoel %} <small>{{ r._pct.koersdoel }} t.o.v. nu</small>{% endif %}</span><span class="p-w">{{ a.koersdoel|getal(vl) }}</span></summary>
        <p>Waar de koers volgens het normale scenario binnen twee jaar zou staan. Het is een inschatting, geen belofte.{% if a.koersdoel_uitleg %} Onderbouwing: {{ a.koersdoel_uitleg|inline }}.{% endif %}</p></details>
      {%- endif %}
      {%- if a.stop_loss %}
      <details class="prijs"><summary class="p-rij"><i class="k stop"></i><span class="p-naam">Stop-loss <small>−20% onder je aankoopprijs</small></span><span class="p-w">{{ a.stop_loss.waarde|getal(vl) }}</span></summary>
        <p>De koers waarop je verkoopt om een groter verlies te vermijden. Die hangt af van de prijs waartegen jij koopt. {{ a.stop_loss.uitleg|inline }}</p></details>
      {%- endif %}
      {%- if a.intrinsieke_waarde %}
      <details class="prijs"><summary class="p-rij"><i class="k iw"></i><span class="p-naam">Intrinsieke waarde{% if r._pct.iw %} <small>{{ r._pct.iw }} t.o.v. nu</small>{% endif %}</span><span class="p-w">{{ a.intrinsieke_waarde|getal(vl) }}</span></summary>
        <p>Wat één aandeel volgens de berekening echt waard is, los van de beurskoers. Het is een schatting; de onderbouwing staat in het hoofdstuk <a href="#waardering">Waardering</a>.</p></details>
      {%- endif %}
    </div>
    {%- if a.scenarios %}
    <div class="vol">
      <div class="sub-titel">Wat kan de koers over twee jaar doen?</div>
      <p class="deel-intro">Niemand kent de toekomst. Daarom drie mogelijke uitkomsten, telkens met de koers die erbij hoort en hoe waarschijnlijk we dat vinden. Tik op een uitkomst voor de redenering.</p>
    </div>
    <div class="scenarios">
      {%- for s in a.scenarios %}
      <details class="scenario {{ s.naam }}"><summary><span class="n">{{ s.naam }}{% if s.kans %} · kans {{ s.kans }}{% endif %}</span><span class="w">{{ s.koers|getal(vl) }}{% if r._pct.scenarios[loop.index0] %} <small>{{ r._pct.scenarios[loop.index0] }}</small>{% endif %}</span></summary><p>{{ s.uitleg|inline }}</p></details>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if r.verkoopsignalen %}
    <div class="vol kader waarschuwing"><div class="t">Wanneer verkopen? Hou dit in de gaten:</div>
      <ul>{% for s in r.verkoopsignalen %}<li>{{ s|inline }}</li>{% endfor %}</ul></div>
    {%- endif %}
    {%- if a.score_opbouw %}
    {%- set so = a.score_opbouw %}{% set be = so._berekend or {} %}
    <details class="scoreopbouw uitklap">
      <summary><span class="so-titel">Hoe komt de score {{ a.score }}/10 tot stand?</span></summary>
      {%- if so.uitleg %}<p class="so-intro">{{ so.uitleg|inline }}</p>{% endif %}
      {%- for o in so.onderdelen %}
      <div class="so-rij">
        <div class="so-kop"><span class="so-naam">{{ o.naam }}</span><span class="so-p">{{ o.punten|getal }}/10</span></div>
        <div class="so-balk"><i style="width: {{ (o.punten or 0) * 10 }}%"></i></div>
        <div class="so-uitleg">Weegt {{ o.gewicht|getal }}% · {{ o.uitleg|inline }}</div>
      </div>
      {%- endfor %}
      <div class="so-som">Gewogen gemiddelde: <strong>{{ be.basis|getal }}</strong></div>
      {%- for x in so.correcties or [] %}
      <div class="so-rij so-corr">
        <div class="so-kop"><span class="so-naam">{{ x.naam }}</span><span class="so-p">{{ '%+g'|format(x.punten) }}</span></div>
        <div class="so-uitleg">{{ x.uitleg|inline }}</div>
      </div>
      {%- endfor %}
      <div class="so-som totaal">Totaal {{ be.totaal|getal }} → afgerond <strong>{{ a.score }}/10</strong></div>
    </details>
    {%- endif %}
  </section>

  <section class="pdf-blok kaart vlaggen" id="vlaggen">
    <div class="deel">Deel {{ d.vlag }}</div>
    <h2>🚩 Rode vlaggen</h2>
    <p class="deel-intro">Hier staat alles wat botst met jouw harde regels (R1 tot en met R6 uit je profiel). Per punt lees je wat er aan de hand is, waarom het belangrijk is voor jou en hoe erg het is. De cijfers en bronnen zitten onder "De details". <strong>No-go</strong> betekent: normaal niet kopen.</p>
    {%- if r._vlaggen %}
      {%- for v in r._vlaggen %}
      <div class="vlag {{ v.ernst }}">
        <div><span class="e">{{ {'nogo':'No-go','hoog':'Hoog','middel':'Middel','info':'Info'}[v.ernst] }}{% if v.regel %} · {{ v.regel }}{% endif %}</span><span class="t">{{ v.titel }}</span></div>
        {%- for b in v._kern %}{{ blok(b) }}{% endfor %}
        {%- if v._details %}<details class="uitklap vlag-details"><summary>De details: cijfers, data en bronnen</summary>{% for b in v._details %}{{ blok(b) }}{% endfor %}</details>{% endif %}
      </div>
      {%- endfor %}
    {%- else %}
      <p class="geen-vlag">Geen rode vlaggen gevonden.</p>
    {%- endif %}
    {%- if r._vlaggen_info %}
    <div class="sub-titel nagekeken">Nagekeken, geen alarm</div>
    <p class="deel-intro">Deze regels zijn gecontroleerd. Er is niets ernstigs gevonden, maar je weet graag wat er gezien is.</p>
      {%- for v in r._vlaggen_info %}
      <details class="uitklap vlag info">
        <summary><span class="e">{% if v.regel %}{{ v.regel }}{% else %}Info{% endif %}</span><span class="t">{{ v.titel }}</span></summary>
        {%- for b in v.uitleg %}{{ blok(b) }}{% endfor %}
      </details>
      {%- endfor %}
    {%- endif %}
  </section>

  {%- if r.onvoldoende_info %}
  <section class="pdf-blok kaart">
    <h2>Onvoldoende info gevonden</h2>
    {%- for o in r.onvoldoende_info %}
    <div class="kader waarschuwing"><div class="t">{{ o.onderwerp }}</div>
      {{ o.wat_wel|inline }}
      <div class="bijschrift">Gezocht in {{ o.zoekrondes|length }} rondes: {{ o.zoekrondes|join('; ') }}</div></div>
    {%- endfor %}
  </section>
  {%- endif %}

  <nav class="pdf-blok kaart inhoudstafel" id="details">
    <div class="deel">Deel {{ d.det }}</div>
    <h2>Details per thema</h2>
    <p class="deel-intro">Elk hoofdstuk gaat dieper in op één onderwerp en begint met een korte uitleg waarover het gaat. Tik op een titel om het te openen.</p>
    <ol>
      {%- for s in r.secties %}<li><a href="#{{ s.id }}">{{ s.titel }}</a>{% if s.kort %} <span class="kort">— {{ s.kort }}</span>{% endif %}</li>{% endfor %}
    </ol>
  </nav>

  {%- for s in r.secties %}
  <details class="sectie pdf-blok" id="{{ s.id }}">
    <summary><span><span class="nr">{{ loop.index }}.</span> {{ s.titel }}{% if s.kort %}<span class="kort">{{ s.kort }}</span>{% endif %}</span></summary>
    <div class="inhoud">
      {%- if s.id == 'bestuur' and r.aandeelhouders %}
        {%- set ah = r.aandeelhouders %}
        <div class="tabel-titel">Aandeelhoudersstructuur{{ ah.bronnen|refs }}</div>
        {%- if r._ah_balk %}
        <div class="ah-balk" role="img" aria-label="Verdeling van de aandelen; de drie grootste aandeelhouders samen {{ r._r1.top3|getal if r._r1 else '' }}%">
          <div class="ah-spoor">{% for x in r._ah_balk %}<i class="{{ x.soort }}" style="width: {{ x.pct }}%" title="{{ x.naam }} {{ x.pct|getal }}%"></i>{% endfor %}<b class="ah-grens" style="left: 49%"><span>49%-grens</span></b></div>
          <div class="pb-legende"><span><i class="k ah-top"></i>drie grootste aandeelhouders{% if r._r1 %} ({{ r._r1.top3|getal }}%){% endif %}</span><span><i class="k ah-ander"></i>andere gemelde</span><span><i class="k ah-eigen"></i>eigen aandelen</span><span><i class="k ah-vrij"></i>vrij verhandelbaar</span></div>
        </div>
        {%- endif %}
        <div class="tabelwrap"><table>
          <thead><tr><th>Aandeelhouder</th><th>Kapitaal %</th><th>Stemrecht %</th></tr></thead>
          <tbody>{% for x in ah.verdeling %}<tr><td>{{ x.naam }}{% if x.structuur %}<div class="bijschrift">{{ x.structuur }}</div>{% endif %}</td><td>{{ x.pct|getal }}</td><td>{{ (x.stemrecht_pct if x.stemrecht_pct is not none else x.pct)|getal }}</td></tr>{% endfor %}</tbody>
        </table></div>
        {%- if r._r1 %}<div class="kader {{ 'waarschuwing' if r._r1.geraakt }}"><div class="t">Regel R1 (> 49%): {{ 'GERAAKT' if r._r1.geraakt else 'niet geraakt' }}</div>Grootste aandeelhouder {{ r._r1.grootste|getal }}% · top 3 samen {{ r._r1.top3|getal }}% kapitaal / {{ r._r1.top3_stem|getal }}% stemrecht.</div>{% endif %}
        {%- if ah.uitleg %}<p class="blok">{{ ah.uitleg|inline }}</p>{% endif %}
      {%- endif %}
      {%- for b in s._intro %}{{ blok(b) }}{% endfor %}
      {%- if s.id == 'keten' and r.keten_schema %}
        {%- set ks = r.keten_schema %}
        <div class="tabel-titel">{{ ks.titel or 'De keten in één beeld' }}</div>
        <div class="keten">
          <div class="kt-centrum">{{ ks.centrum }}</div>
          <ul class="kt-takken">
            {%- for t in ks.takken %}
            <li><div class="kt-tak"><strong>{{ t.naam }}</strong>{% if t.gewicht %}<span class="kt-gewicht">{{ t.gewicht }}</span>{% endif %}{% if t.toelichting %}<div class="kt-uitleg">{{ t.toelichting|inline }}</div>{% endif %}</div>
              {%- if t.onder %}<ul class="kt-onder">{% for o in t.onder %}<li><strong>{{ o.naam }}</strong>{% if o.toelichting %} — {{ o.toelichting|inline }}{% endif %}</li>{% endfor %}</ul>{% endif %}
            </li>
            {%- endfor %}
          </ul>
        </div>
        <div class="bijschrift">{{ ks.noot or 'Niveau 1 (kaders) en niveau 2 (lijntjes eronder). Dit is een samenvatting: cijfers en bronnen staan in de onderdelen hieronder.' }}</div>
      {%- endif %}
      {%- for dl in s._delen %}
      <details class="uitklap onderdeel"><summary>{{ dl.titel }}</summary>{% for b in dl.blokken %}{{ blok(b) }}{% endfor %}</details>
      {%- endfor %}
    </div>
  </details>
  {%- endfor %}

  <div class="achteraan-kop"><div class="deel">Deel {{ d.ach }} · Achteraan</div></div>

  {%- if r._woordenlijst %}
  <details class="pdf-blok kaart uitklap">
    <summary><h2>Woordenlijst <small>({{ r._woordenlijst|length }} termen)</small></h2></summary>
    <dl class="woorden">{% for t, u in r._woordenlijst %}<dt>{{ t }}</dt><dd>{{ u }}</dd>{% endfor %}</dl>
  </details>
  {%- endif %}

  {%- if r.review %}
  {%- set rv = r.review %}
  <section class="pdf-blok kaart">
    <h2>Kwaliteitscontrole</h2>
    <p class="deel-intro">Elk rapport wordt nagelezen door drie controleurs: een financieel analist (kloppen de cijfers met de bronnen?), een actua-specialist (is het nieuws juist en volledig?) en een kritische belegger (is het advies logisch en duidelijk?). Hieronder kort wat ze deden en wat nog openstaat.</p>
    {%- if r.meta.soort == 'snelle_update' %}<div class="kader info"><div class="t">Dit is een snelle update</div>Enkel koers, nieuws en officiële meldingen sinds het vorige rapport zijn nagekeken, met één controleronde. De volledige analyse staat in het rapport van {{ r.meta.basis_rapport or r.meta.vorig_rapport }}.</div>{% endif %}
    <p class="blok" style="font-size:14px">{{ rv.rondes|length }} reviewronde(s) door financieel analist, actua-specialist en kritische belegger.
    {%- if rv.feiten_gecontroleerd %} {{ rv.feiten_gecontroleerd }} feiten naast de bron gelegd{% if rv.feiten_correct is not none %}, {{ rv.feiten_correct }} meteen correct{% endif %}.{% endif %}
    {%- set ns = namespace(o=0, v=0, w=0) %}{% for rd in rv.rondes %}{% set ns.o = ns.o + (rd.opmerkingen or 0) %}{% set ns.v = ns.v + (rd.verwerkt or 0) %}{% set ns.w = ns.w + (rd.verworpen or 0) %}{% endfor %}
    {{ ns.o }} opmerkingen: {{ ns.v }} verwerkt, {{ ns.w }} gemotiveerd verworpen.</p>
    {%- if rv.rondes %}{% set last = rv.rondes[-1] %}
    <div class="legende-labels">{% for n, o in last.oordelen.items() %}<span><strong>{{ {'financieel-analist':'Financieel analist','actua-specialist':'Actua-specialist','kritische-belegger':'Kritische belegger'}.get(n, n) }}:</strong> {{ o }}</span>{% endfor %}</div>
    {%- endif %}
    {%- if rv.open_punten %}
    <div class="kader waarschuwing"><div class="t">Open punten / meningsverschillen in het team</div><ul>{% for o in rv.open_punten %}<li>{{ o|inline }}</li>{% endfor %}</ul></div>
    {%- endif %}
  </section>
  {%- endif %}

  <details class="pdf-blok kaart uitklap" id="bronnen">
    <summary><h2>Bronnen <small>({{ r.bronnen|length }})</small></h2></summary>
    <ol class="bronnen">
      {%- for b in r.bronnen %}
      <li id="bron-{{ b.id }}"><span class="type">{{ b.type or '' }}</span>{% if b._rang == 'D' %} <span class="type zwak">zwakke bron</span>{% endif %} {{ b.uitgever }} — {% if b.url %}<a href="{{ b.url }}" target="_blank" rel="noopener">{{ b.titel }}</a>{% else %}{{ b.titel }}{% endif %}{% if b.document %} ({{ b.document }}){% endif %}{% if b.datum %}, {{ b.datum }}{% endif %}</li>
      {%- endfor %}
    </ol>
  </details>

  <p class="voet">Gemaakt op {{ gebouwd }}. Dit is onderzoek en mening, geen gereglementeerd financieel advies. De beslissing ligt bij jou.</p>
</main>
<script>
document.addEventListener("click", function (e) {
  var t = e.target.closest(".term");
  if (t) { e.preventDefault(); var o = t.classList.toggle("open"); t.setAttribute("aria-expanded", o); return; }
  var a = e.target.closest("a[href^='#']");
  if (!a) return;
  var d = document.getElementById(a.getAttribute("href").slice(1));
  for (var p = d; p; p = p.parentElement) if (p.tagName === "DETAILS") p.open = true;
});
document.addEventListener("keydown", function (e) {
  if ((e.key === "Enter" || e.key === " ") && e.target.classList && e.target.classList.contains("term")) { e.preventDefault(); e.target.click(); }
});
</script>
</body>
</html>
